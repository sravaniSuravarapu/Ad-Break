# Copy to backend/.env for a host-run API. Do not commit real secrets.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=adbreak
DATABASE_USER=adbreak
DATABASE_PASSWORD=adbreak
# Optional full override. Leave unset to build the URL from the fields above.
# DATABASE_URL=postgresql+psycopg://adbreak:adbreak@localhost:5432/adbreak
JWT_SECRET=dev-only-change-me
JWT_EXPIRE_MINUTES=60
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
SEED_DEMO=true
